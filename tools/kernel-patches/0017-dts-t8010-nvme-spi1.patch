+
+/* Audio (Test): ADT spi1 – audio-codec (CS42L71) an CS0 = GPIO 0x83,
+ * maggie-arc (Lattice iCE5LP4K) an CS1 = GPIO 0xb1. Zugriff per spidev. */
+&spi1 {
+	status = "okay";
+	cs-gpios = <&pinctrl_ap 131 GPIO_ACTIVE_HIGH>, <&pinctrl_ap 177 GPIO_ACTIVE_HIGH>;
+	/* ADT: Codec Mode 0, Maggie Mode 3 – Modus je Gerät beachten */
+	apple,honor-spi-mode;
+
+	audio_codec_spi: spidev@0 {
+		compatible = "rohm,dh2228fv";
+		reg = <0>;
+		spi-max-frequency = <2500000>;
+	};
+
+	maggie_spi: maggie@1 {
+		compatible = "rohm,dh2228fv";
+		reg = <1>;
+		spi-max-frequency = <4000000>;
+		spi-cpol;
+		spi-cpha;
+	};
+};
