+#define BCM_TAURUS_CAL_CHUNK 0xe6
+struct bcm_taurus_cal_cmd {
+	u8 unk;
+	__le16 blocks_left;
+	u8 data[BCM_TAURUS_CAL_CHUNK];
+} __packed;
+
+static int bcm_send_taurus_cal(struct hci_uart *hu, const u8 *data, size_t size)
+{
+	size_t blocks = DIV_ROUND_UP(size, (size_t)BCM_TAURUS_CAL_CHUNK);
+	struct bcm_taurus_cal_cmd cmd;
+	struct sk_buff *skb;
+	size_t i, len;
+
+	bt_dev_info(hu->hdev, "sende %zu Byte Taurus-Kalibrierung", size);
+	for (i = 0; i < blocks; i++) {
+		len = min_t(size_t, size - i * BCM_TAURUS_CAL_CHUNK, BCM_TAURUS_CAL_CHUNK);
+		memset(&cmd, 0, sizeof(cmd));
+		cmd.unk = 0x03;
+		cmd.blocks_left = cpu_to_le16(blocks - i - 1);
+		memcpy(cmd.data, data + i * BCM_TAURUS_CAL_CHUNK, len);
+		skb = __hci_cmd_sync(hu->hdev, 0xfd97, sizeof(cmd), &cmd, HCI_INIT_TIMEOUT);
+		if (IS_ERR(skb))
+			return PTR_ERR(skb);
+		kfree_skb(skb);
+	}
+	return 0;
+}
