 };
+
+&pmgr {
+	touch_clk: clock-controller@78000 {
+		compatible = "apple,t8010-touch-clk";
+		reg = <0x78000 0x8>;
+		clocks = <&clkref>;
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+		clock-output-names = "touch_clk";
+	};
+};
+
+&i2c0 {
+	status = "okay";
+
+	/* Display-PMU "chestnut": Reg 0x05 Bits 0-3 = LCD-LDO (nicht anfassen!), Bit 4 = Touch HV */
+	pmic@27 {
+		compatible = "apple,chestnut-pmic";
+		reg = <0x27>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		touch_hv: touch-hv@5 {
+			compatible = "apple,pmic-switch";
+			reg = <0x5 1>;
+			apple,enable-mask = <0x10>;
+			regulator-name = "touch-hv";
+		};
+	};
+};
+
+&spi2 {
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "apple,t8010-multitouch";
+		reg = <0>;
+		spi-max-frequency = <3000000>;
+		hv-supply = <&touch_hv>;
+		core-supply = <&touch_core>;
+		reset-gpios = <&pinctrl_ap 161 GPIO_ACTIVE_HIGH>;
+		cs-gpios = <&pinctrl_ap 81 GPIO_ACTIVE_HIGH>;
+		irq-gpios = <&pinctrl_ap 166 GPIO_ACTIVE_LOW>;
+		clocks = <&touch_clk>;
+	};
+};
