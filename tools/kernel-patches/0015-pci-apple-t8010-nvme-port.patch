 	struct t8010_pcie *pcie;
 
-	if (bus->number != cfg->busr.start)
-		return true;
 	pcie = pci_host_bridge_priv(dev_get_drvdata(cfg->parent));
+	if (bus->number != cfg->busr.start) {
+		struct pci_dev *rp = bus->self;
+
+		if (PCI_SLOT(devfn) != 0)
