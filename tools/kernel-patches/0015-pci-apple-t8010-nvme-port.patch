 		port->pwr[port->npwr] = g;
 	}
 
+	snprintf(name, sizeof(name), "sart%u", port->idx);
+	if (platform_get_resource_byname(pdev, IORESOURCE_MEM, name)) {
+		u32 sart[4];
+
+		if (of_property_read_u32_array(np, "apple,sart", sart, 4))
+			return dev_err_probe(dev, -EINVAL, "port%u: apple,sart fehlt\n", port->idx);
+		port->sart = devm_platform_ioremap_resource_byname(pdev, name);
+		if (IS_ERR(port->sart))
+			return PTR_ERR(port->sart);
+		spin_lock_init(&port->nvmmu_lock);
+		port->tcb = dmam_alloc_coherent(dev, APPLE_NVMMU_TAGS * NVMMU_TCB_SIZE,
+						&port->tcb_bus, GFP_KERNEL);
+		port->sgl = dmam_alloc_coherent(dev, APPLE_NVMMU_TAGS * APPLE_NVMMU_SGL * 4,
+						&port->sgl_bus, GFP_KERNEL);
+		port->tcb_table = dmam_alloc_coherent(dev, NVMMU_TABLE_SIZE,
+						      &port->table_bus, GFP_KERNEL);
+		if (!port->tcb || !port->sgl || !port->tcb_table)
+			return dev_err_probe(dev, -ENOMEM, "NVMMU-Tabellen\n");
+		port->sart_iova = sart[0];
+		port->sart_pa = ((u64)sart[1] << 32) | sart[2];
+		port->sart_size = sart[3];
+	}
